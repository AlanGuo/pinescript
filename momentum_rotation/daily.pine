//@version=6
indicator("ETF轮动 (日动能)", overlay=false, max_lines_count=500, max_labels_count=500)

// === Universe Inputs ===
symbol1 = input.symbol("SSE:518880", "Symbol 1", group="Universe")
name1   = input.string("黄金ETF", "Label 1", group="Universe")
symbol2 = input.symbol("SSE:513100", "Symbol 2", group="Universe")
name2   = input.string("纳指ETF", "Label 2", group="Universe")
symbol3 = input.symbol("SZSE:159915", "Symbol 3", group="Universe")
name3   = input.string("创业板ETF", "Label 3", group="Universe")
symbol4 = input.symbol("SSE:588000", "Symbol 4", group="Universe")
name4   = input.string("科创50", "Label 4", group="Universe")
symbol5 = input.symbol("SSE:510180", "Symbol 5", group="Universe")
name5   = input.string("上证180", "Label 5", group="Universe")
symbol6 = input.symbol("", "Symbol 6", group="Universe")
name6   = input.string("Label 6", "Label 6", group="Universe")
symbol7 = input.symbol("", "Symbol 7", group="Universe")
name7   = input.string("Label 7", "Label 7", group="Universe")
symbol8 = input.symbol("", "Symbol 8", group="Universe")
name8   = input.string("Label 8", "Label 8", group="Universe")
symbol9 = input.symbol("", "Symbol 9", group="Universe")
name9   = input.string("Label 9", "Label 9", group="Universe")
symbol10 = input.symbol("", "Symbol 10", group="Universe")
name10   = input.string("Label 10", "Label 10", group="Universe")
rotationCount = input.int(3, "参与轮动资产数量", minval=1, maxval=10, group="Universe", tooltip="从上面填写的资产中取前N个参与轮动")
pricePrecision  = input.int(3, "价格精确小数位", minval=0, maxval=6, group="Universe")
var bool[] riskOffExclude = array.new_bool()
var bool marketRiskOff = false

// === Market filter (基准均线) ===
useMarketFilter = input.bool(false, "启用基准均线过滤", group="Market Filter", tooltip="基准指数跌破指定SMA时，可将部分品种从轮动列表中移除")
marketFrictionPct = input.float(0.0, "均线防摩擦系数(%)", minval=0.0, maxval=20.0, step=1, group="Market Filter", tooltip="收盘需高/低于均线一定比例才算上穿/下穿，降低震荡噪声")
forceExitOnFilter = input.bool(true, "风险过滤直接清仓", group="Market Filter", tooltip="开启后，基准跌破SMA且当前持有被标记的风险品种时，按照下方设置立即或次日开盘平仓")
forceExitMode = input.string("次日开盘", "强平成交时点", options=["当日收盘", "次日开盘"], group="Market Filter", tooltip="强平触发时使用的成交价：固定当日收盘或次日开盘")
marketFilterSymbol = input.symbol("SP:SPX", "基准符号", group="Market Filter")
marketFilterLen = input.int(225, "基准SMA长度 (天)", minval=1, group="Market Filter")
exclude1OnDown = input.bool(false, "基准跌破均线时停用Symbol1", group="Market Filter")
exclude2OnDown = input.bool(true,  "基准跌破均线时停用Symbol2", group="Market Filter")
exclude3OnDown = input.bool(true,  "基准跌破均线时停用Symbol3", group="Market Filter")
exclude4OnDown = input.bool(true,  "基准跌破均线时停用Symbol4", group="Market Filter")
exclude5OnDown = input.bool(true,  "基准跌破均线时停用Symbol5", group="Market Filter")
exclude6OnDown = input.bool(true,  "基准跌破均线时停用Symbol6", group="Market Filter")
exclude7OnDown = input.bool(true,  "基准跌破均线时停用Symbol7", group="Market Filter")
exclude8OnDown = input.bool(true,  "基准跌破均线时停用Symbol8", group="Market Filter")
exclude9OnDown = input.bool(true,  "基准跌破均线时停用Symbol9", group="Market Filter")
exclude10OnDown = input.bool(true,  "基准跌破均线时停用Symbol10", group="Market Filter")

fallbackSymbol = marketFilterSymbol
sym1Safe = str.length(symbol1) > 0 ? symbol1 : fallbackSymbol
sym2Safe = str.length(symbol2) > 0 ? symbol2 : fallbackSymbol
sym3Safe = str.length(symbol3) > 0 ? symbol3 : fallbackSymbol
sym4Safe = str.length(symbol4) > 0 ? symbol4 : fallbackSymbol
sym5Safe = str.length(symbol5) > 0 ? symbol5 : fallbackSymbol
sym6Safe = str.length(symbol6) > 0 ? symbol6 : fallbackSymbol
sym7Safe = str.length(symbol7) > 0 ? symbol7 : fallbackSymbol
sym8Safe = str.length(symbol8) > 0 ? symbol8 : fallbackSymbol
sym9Safe = str.length(symbol9) > 0 ? symbol9 : fallbackSymbol
sym10Safe = str.length(symbol10) > 0 ? symbol10 : fallbackSymbol

// === Core logic inputs ===
lookbackDays = input.int(20, "动量回顾(交易日)", minval=1, group="Logic")
signalMaWindowInput = input.int(3, "Signal MA窗口 (0=关闭)", minval=0, group="Logic")
signalMaWindow = signalMaWindowInput <= 1 ? 0 : signalMaWindowInput
signalMaType = input.string("SMA", "Signal MA类型", options=["SMA", "EMA", "RMA"], group="Logic")
signalVolAdjust = input.string("subtract", "波动率调整方式", options=["none", "subtract", "divide"], group="Logic", tooltip="none: 不做波动率调整；subtract: 信号减去波动率项；divide: 信号除以(1+权重*波动率)")
volCalcMethod = input.string("EWMA", "波动率计算方式", options=["EWMA", "STDEV"], group="Logic", tooltip="EWMA: 对收益率平方做EMA后开方；STDEV: 收益率标准差")
volWindow = lookbackDays
volAdjustWeight = input.float(1.0, "波动率调整权重", step=0.1, group="Logic", tooltip="信号 = 原始信号 - 权重 * 波动率(收益率)")
entryThreshold = input.float(0.03, "Entry 阈值(绝对)", step=0.01, group="Logic")
switchDelta = input.float(0.02, "Switch Δ(相对)", step=0.01, group="Logic")
executionMode = input.string("收盘", "换仓时点", options=["收盘", "次日开盘"], group="Logic", tooltip="在信号日收盘成交或下一交易日开盘成交")
useCloseRebalance = executionMode == "收盘"
alignDailySeries = input.bool(true, "日线对齐(跨品种)", group="Logic", tooltip="解决不同主图下 request.security(\"D\") 日线序列错位：在日线图上使用 lookahead_on 将各品种对齐到同一天（等价于以当日收盘数据决策）")
initialEquity = input.float(1, "初始净值", minval=0, group="Logic")
backtestStart = input.time(timestamp("2014-12-25T00:00:00"), "Backtest Start", confirm=true, group="Logic")
backtestEnd = input.time(timestamp("2099-12-31T23:59:59"), "Backtest End", confirm=true, group="Logic")
bool inRange = time >= backtestStart and time <= backtestEnd

// === Display / debug ===
showForceExitLabel = input.bool(true, "显示强平标注", group="Display")
showMaxDdLabel   = input.bool(true, "显示最大回撤标注", group="Display")

// === Alerts ===
showSwitchLabel  = input.bool(true, "仓位操作提醒(标签+alert)", group="Alert", tooltip="开仓/换仓/平仓/强平的成交提醒；关闭后不显示相关标签且不触发成交 alert")
enableIntradayPreAlert = input.bool(true, "盘中预警(标签+alert)", group="Alert", tooltip="日内实时预警（包含：收盘换仓盘中预警 + 强平盘中预警）；开启后会同时触发 alert 并在图上绘制预警标签；预警基于未收盘的当日价格计算，可能在收盘前失效/反复")

enableDdDebug = input.bool(false, "启用回撤调试日志", group="Debug")
enableEquityDebug = input.bool(false, "启用净值调试日志", group="Debug")
enableFloatingEquityDebug = input.bool(false, "启用浮动净值调试日志", group="Debug")
enablePositionLog = input.bool(false, "启用仓位变动日志", group="Debug")
enableMomentumLog = input.bool(false, "启用动量计算日志", group="Debug")
enableFilterLog = input.bool(false, "启用基准过滤日志", group="Debug")
enableDecisionLog = input.bool(false, "启用信号判定日志", group="Debug")
enableAlignmentLog = input.bool(false, "启用时间对齐调试日志", group="Debug", tooltip="用于排查不同主图下 request.security 日线序列对齐到主图时间轴时产生的偏移；默认只打印日期不一致的情况")

formatDate(int ts) =>
    if na(ts)
        "N/A"
    else
        yearStr = str.tostring(year(ts))
        monthVal = month(ts)
        dayVal = dayofmonth(ts)
        monthStr = monthVal < 10 ? "0" + str.tostring(monthVal) : str.tostring(monthVal)
        dayStr = dayVal < 10 ? "0" + str.tostring(dayVal) : str.tostring(dayVal)
        str.format("{0}-{1}-{2}", yearStr, monthStr, dayStr)

priceScale() => math.pow(10.0, pricePrecision)
roundPrice(float v) => na(v) ? na : math.round(v * priceScale()) / priceScale()
fmtPrice(float v) => na(v) ? "N/A" : str.tostring(v)

// === Build symbol lists ===
var string[] tickers = array.new_string()
var string[] labels  = array.new_string()
var int[] tickerSlots = array.new_int()
if barstate.isfirst
    array.clear(riskOffExclude)
    array.clear(tickers)
    array.clear(labels)
    array.clear(tickerSlots)
    if str.length(symbol1) > 0
        array.push(tickers, symbol1)
        array.push(labels,  name1)
        array.push(riskOffExclude, exclude1OnDown)
        array.push(tickerSlots, 1)
    if str.length(symbol2) > 0
        array.push(tickers, symbol2)
        array.push(labels,  name2)
        array.push(riskOffExclude, exclude2OnDown)
        array.push(tickerSlots, 2)
    if str.length(symbol3) > 0
        array.push(tickers, symbol3)
        array.push(labels,  name3)
        array.push(riskOffExclude, exclude3OnDown)
        array.push(tickerSlots, 3)
    if str.length(symbol4) > 0
        array.push(tickers, symbol4)
        array.push(labels,  name4)
        array.push(riskOffExclude, exclude4OnDown)
        array.push(tickerSlots, 4)
    if str.length(symbol5) > 0
        array.push(tickers, symbol5)
        array.push(labels,  name5)
        array.push(riskOffExclude, exclude5OnDown)
        array.push(tickerSlots, 5)
    if str.length(symbol6) > 0
        array.push(tickers, symbol6)
        array.push(labels,  name6)
        array.push(riskOffExclude, exclude6OnDown)
        array.push(tickerSlots, 6)
    if str.length(symbol7) > 0
        array.push(tickers, symbol7)
        array.push(labels,  name7)
        array.push(riskOffExclude, exclude7OnDown)
        array.push(tickerSlots, 7)
    if str.length(symbol8) > 0
        array.push(tickers, symbol8)
        array.push(labels,  name8)
        array.push(riskOffExclude, exclude8OnDown)
        array.push(tickerSlots, 8)
    if str.length(symbol9) > 0
        array.push(tickers, symbol9)
        array.push(labels,  name9)
        array.push(riskOffExclude, exclude9OnDown)
        array.push(tickerSlots, 9)
    if str.length(symbol10) > 0
        array.push(tickers, symbol10)
        array.push(labels,  name10)
        array.push(riskOffExclude, exclude10OnDown)
        array.push(tickerSlots, 10)
    idx = array.size(tickers) - 1
    while idx >= 0
        sym = array.get(tickers, idx)
        if str.length(sym) == 0
            array.remove(tickers, idx)
            array.remove(labels, idx)
            array.remove(riskOffExclude, idx)
            array.remove(tickerSlots, idx)
        idx -= 1
    while array.size(tickers) > rotationCount
        array.pop(tickers)
        array.pop(labels)
        array.pop(riskOffExclude)
        array.pop(tickerSlots)

assetCount = array.size(tickers)
if assetCount == 0
    runtime.error("请至少填写一个可交易品种")

// === Per-asset storage ===
var float[] momentumLookback = array.new_float()
var float[] signalSeries = array.new_float()
var float[] signalBaseSeries = array.new_float()
var float[] signalDecisionSeries = array.new_float()
var float[] volSeries = array.new_float()
var float[] prevSignalSeries = array.new_float()
var float[] closeSeries = array.new_float()
var float[] openSeries = array.new_float()
var float[] lowSeries = array.new_float()
var int[] displayOrder = array.new_int()
var float[] symCumReturn = array.new_float()
var float[] symProfitSum = array.new_float()
var float[] symLossSum = array.new_float()
var int[] symWinCount = array.new_int()
var int[] symTradeCount = array.new_int()

if barstate.isfirst
    array.clear(momentumLookback)
    array.clear(signalSeries)
    array.clear(signalBaseSeries)
    array.clear(signalDecisionSeries)
    array.clear(volSeries)
    array.clear(prevSignalSeries)
    array.clear(closeSeries)
    array.clear(openSeries)
    array.clear(lowSeries)
    array.clear(displayOrder)
    array.clear(symCumReturn)
    array.clear(symProfitSum)
    array.clear(symLossSum)
    array.clear(symWinCount)
    array.clear(symTradeCount)
    for i = 0 to assetCount - 1
        array.push(momentumLookback, na)
        array.push(signalSeries, na)
        array.push(signalBaseSeries, na)
        array.push(signalDecisionSeries, na)
        array.push(volSeries, na)
        array.push(prevSignalSeries, na)
        array.push(closeSeries, na)
        array.push(openSeries, na)
        array.push(lowSeries, na)
        array.push(displayOrder, i)
        array.push(symCumReturn, 1.0)
        array.push(symProfitSum, 0.0)
        array.push(symLossSum,   0.0)
        array.push(symWinCount,  0)
        array.push(symTradeCount, 0)

color0  = color.new(color.orange, 50)
color1  = color.new(color.blue, 50)
color2  = color.new(color.red, 50)
color3  = color.new(color.purple, 50)
color4  = color.new(color.green, 50)
color5  = color.new(color.teal, 50)
color6  = color.new(color.yellow, 50)
color7  = color.new(color.fuchsia, 50)
color8  = color.new(color.aqua, 50)
color9  = color.new(color.gray, 50)
getColor(int idx) =>
    idx == 0 ? color0 :
      idx == 1 ? color1 :
      idx == 2 ? color2 :
      idx == 3 ? color3 :
      idx == 4 ? color4 :
      idx == 5 ? color5 :
      idx == 6 ? color6 :
      idx == 7 ? color7 :
      idx == 8 ? color8 :
      idx == 9 ? color9 : na

isSymbolEligible(int idx) =>
    if not useMarketFilter
        true
    else if not marketRiskOff
        true
    else if idx >= array.size(riskOffExclude)
        true
    else
        not array.get(riskOffExclude, idx)

sanitizedSignal(float val) => na(val) ? -1e10 : val

sortTableRowsBySignal() =>
    rows = array.size(displayOrder)
    if rows >= 2
        for i = 0 to rows - 2
            bestPos = i
            bestIdx = array.get(displayOrder, bestPos)
            bestVal = sanitizedSignal(array.get(signalSeries, bestIdx))
            for j = i + 1 to rows - 1
                currIdx = array.get(displayOrder, j)
                currVal = sanitizedSignal(array.get(signalSeries, currIdx))
                if currVal > bestVal
                    bestPos := j
                    bestIdx := currIdx
                    bestVal := currVal
            if bestPos != i
                tmp = array.get(displayOrder, i)
                array.set(displayOrder, i, array.get(displayOrder, bestPos))
                array.set(displayOrder, bestPos, tmp)

pickFloat(int slot, float v1, float v2, float v3, float v4, float v5, float v6, float v7, float v8, float v9, float v10) =>
    slot == 1 ? v1 :
      slot == 2 ? v2 :
      slot == 3 ? v3 :
      slot == 4 ? v4 :
      slot == 5 ? v5 :
      slot == 6 ? v6 :
      slot == 7 ? v7 :
      slot == 8 ? v8 :
      slot == 9 ? v9 :
      slot == 10 ? v10 : na

pickInt(int slot, int v1, int v2, int v3, int v4, int v5, int v6, int v7, int v8, int v9, int v10) =>
    slot == 1 ? v1 :
      slot == 2 ? v2 :
      slot == 3 ? v3 :
      slot == 4 ? v4 :
      slot == 5 ? v5 :
      slot == 6 ? v6 :
      slot == 7 ? v7 :
      slot == 8 ? v8 :
      slot == 9 ? v9 :
      slot == 10 ? v10 : na

int maLenSafe = math.max(signalMaWindow, 1)

calcVol() =>
    ret = close / close[1] - 1
    if volCalcMethod == "EWMA"
        ewmaVar = ta.ema(ret * ret, volWindow)
        math.sqrt(ewmaVar)
    else
        ta.stdev(ret, volWindow)

calcMomentum() =>
    close / close[lookbackDays] - 1

calcSignalBase() =>
    m = close / close[lookbackDays] - 1
    ema = ta.ema(m, maLenSafe)
    rma = ta.rma(m, maLenSafe)
    sma = ta.sma(m, maLenSafe)
    signalMaWindow > 0 ? (signalMaType == "EMA" ? ema : signalMaType == "RMA" ? rma : sma) : m

calcSignal() =>
    signalBase = calcSignalBase()
    signalAdjusted = signalBase
    float vol = na
    if signalVolAdjust == "subtract"
        vol := calcVol()
        signalAdjusted -= volAdjustWeight * vol
    else if signalVolAdjust == "divide"
        vol := na(vol) ? calcVol() : vol
        float denom = 1 + volAdjustWeight * vol
        signalAdjusted := denom != 0 ? signalAdjusted / denom : na
    signalAdjusted

// === Precomputed daily series (lookahead_off / lookahead_on) ===
[dTime1Off, dClose1Off, dOpen1Off, dLow1Off, dMom1Off, dVol1Off, dSigBase1Off, dSig1Off] = request.security(sym1Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[dTime2Off, dClose2Off, dOpen2Off, dLow2Off, dMom2Off, dVol2Off, dSigBase2Off, dSig2Off] = request.security(sym2Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[dTime3Off, dClose3Off, dOpen3Off, dLow3Off, dMom3Off, dVol3Off, dSigBase3Off, dSig3Off] = request.security(sym3Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[dTime4Off, dClose4Off, dOpen4Off, dLow4Off, dMom4Off, dVol4Off, dSigBase4Off, dSig4Off] = request.security(sym4Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[dTime5Off, dClose5Off, dOpen5Off, dLow5Off, dMom5Off, dVol5Off, dSigBase5Off, dSig5Off] = request.security(sym5Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[dTime6Off, dClose6Off, dOpen6Off, dLow6Off, dMom6Off, dVol6Off, dSigBase6Off, dSig6Off] = request.security(sym6Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[dTime7Off, dClose7Off, dOpen7Off, dLow7Off, dMom7Off, dVol7Off, dSigBase7Off, dSig7Off] = request.security(sym7Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[dTime8Off, dClose8Off, dOpen8Off, dLow8Off, dMom8Off, dVol8Off, dSigBase8Off, dSig8Off] = request.security(sym8Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[dTime9Off, dClose9Off, dOpen9Off, dLow9Off, dMom9Off, dVol9Off, dSigBase9Off, dSig9Off] = request.security(sym9Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[dTime10Off, dClose10Off, dOpen10Off, dLow10Off, dMom10Off, dVol10Off, dSigBase10Off, dSig10Off] = request.security(sym10Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

[dTime1On, dClose1On, dOpen1On, dLow1On, dMom1On, dVol1On, dSigBase1On, dSig1On] = request.security(sym1Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[dTime2On, dClose2On, dOpen2On, dLow2On, dMom2On, dVol2On, dSigBase2On, dSig2On] = request.security(sym2Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[dTime3On, dClose3On, dOpen3On, dLow3On, dMom3On, dVol3On, dSigBase3On, dSig3On] = request.security(sym3Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[dTime4On, dClose4On, dOpen4On, dLow4On, dMom4On, dVol4On, dSigBase4On, dSig4On] = request.security(sym4Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[dTime5On, dClose5On, dOpen5On, dLow5On, dMom5On, dVol5On, dSigBase5On, dSig5On] = request.security(sym5Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[dTime6On, dClose6On, dOpen6On, dLow6On, dMom6On, dVol6On, dSigBase6On, dSig6On] = request.security(sym6Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[dTime7On, dClose7On, dOpen7On, dLow7On, dMom7On, dVol7On, dSigBase7On, dSig7On] = request.security(sym7Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[dTime8On, dClose8On, dOpen8On, dLow8On, dMom8On, dVol8On, dSigBase8On, dSig8On] = request.security(sym8Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[dTime9On, dClose9On, dOpen9On, dLow9On, dMom9On, dVol9On, dSigBase9On, dSig9On] = request.security(sym9Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[dTime10On, dClose10On, dOpen10On, dLow10On, dMom10On, dVol10On, dSigBase10On, dSig10On] = request.security(sym10Safe, "D", [time, close, open, low, calcMomentum(), calcVol(), calcSignalBase(), calcSignal()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

// === Market filter computation ===
marketClose = request.security(marketFilterSymbol, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
marketDate = request.security(marketFilterSymbol, "D", time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
marketSma = request.security(marketFilterSymbol, "D", ta.sma(close, marketFilterLen), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
marketClosePre = request.security(marketFilterSymbol, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
marketSmaPre = request.security(marketFilterSymbol, "D", ta.sma(close, marketFilterLen), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
friction = marketFrictionPct * 0.01
smaUp = marketSma * (1 + friction)
smaDown = marketSma * (1 - friction)
marketSmaDownPre = marketSmaPre * (1 - friction)
marketWouldRiskOffPre = marketClosePre <= marketSmaDownPre
marketAboveSma = marketClose >= smaUp
marketBelowSma = marketClose <= smaDown
marketCrossUp = ta.crossover(marketClose, smaUp)
marketCrossDown = ta.crossunder(marketClose, smaDown)
if useMarketFilter and inRange and barstate.isconfirmed and (marketCrossUp or marketCrossDown)
    dirTxt = marketCrossUp ? "上穿" : "下穿"
    crossDateTxt = formatDate(marketDate)
    if marketCrossDown
        marketRiskOff := true
    else if marketCrossUp
        marketRiskOff := false
    if enableFilterLog
        log.warning(str.format("基准 {0} {1} SMA{2}±{3,number,#.##}% 交易日 {4} 收盘 {5} 上沿 {6} 下沿 {7}", marketFilterSymbol, dirTxt, marketFilterLen, marketFrictionPct, crossDateTxt, str.tostring(marketClose, format.mintick), str.tostring(smaUp, format.mintick), str.tostring(smaDown, format.mintick)))

// === Tables ===
var table infoTable = na
var table ddTable = na
if barstate.isfirst
    infoTable := table.new(position.top_right, 10, assetCount + 1, border_width=1)
    ddTable := table.new(position.bottom_right, 2, 6, border_width=1)

// === Strategy state ===
var int holdingIdx = na
var string heldLabel = "未持仓"
var float equity = initialEquity
var float equityClosedSeries = initialEquity
var float equityDailySeries = initialEquity
var float entryPrice = na
var float entryEquity = initialEquity
var float holdingDays = 0
var float lastSellPrice = na
var float lastBuyPrice = na
var float holdingPnlSeries = na
var float peakEquity = initialEquity
var float lastLoggedEquity = na
var float maxDrawdownSeries = 0.0
var float currentDrawdown = 0.0
var float rebalancePriceSeries = na
var label lastSwitch = na
var label maxDdLabel = na
var int preAlertDay = na
var string preAlertLastMsg = ""
var int forcePreAlertDay = na
var string forcePreAlertLastMsg = ""
var bool holdingChanged = false
var float sumTradeRet = 0.0
var float sumTradeRetSq = 0.0
var int tradeSamples = 0
var bool forceExitPending = false
var int forceExitPendingIdx = na
var int forceExitPendingDay = na
var float forceExitPendingBasis = na
var string forceExitPendingNote = ""

// === Per-bar computations ===
bool useAlignedDaily = timeframe.isdaily and alignDailySeries
for i = 0 to assetCount - 1
    string sym = array.get(tickers, i)
    int slot = array.get(tickerSlots, i)
    int symTime = pickInt(slot,
      useAlignedDaily ? dTime1On : dTime1Off,
      useAlignedDaily ? dTime2On : dTime2Off,
      useAlignedDaily ? dTime3On : dTime3Off,
      useAlignedDaily ? dTime4On : dTime4Off,
      useAlignedDaily ? dTime5On : dTime5Off,
      useAlignedDaily ? dTime6On : dTime6Off,
      useAlignedDaily ? dTime7On : dTime7Off,
      useAlignedDaily ? dTime8On : dTime8Off,
      useAlignedDaily ? dTime9On : dTime9Off,
      useAlignedDaily ? dTime10On : dTime10Off)
    float symClose = pickFloat(slot,
      useAlignedDaily ? dClose1On : dClose1Off,
      useAlignedDaily ? dClose2On : dClose2Off,
      useAlignedDaily ? dClose3On : dClose3Off,
      useAlignedDaily ? dClose4On : dClose4Off,
      useAlignedDaily ? dClose5On : dClose5Off,
      useAlignedDaily ? dClose6On : dClose6Off,
      useAlignedDaily ? dClose7On : dClose7Off,
      useAlignedDaily ? dClose8On : dClose8Off,
      useAlignedDaily ? dClose9On : dClose9Off,
      useAlignedDaily ? dClose10On : dClose10Off)
    float symOpen  = pickFloat(slot,
      useAlignedDaily ? dOpen1On : dOpen1Off,
      useAlignedDaily ? dOpen2On : dOpen2Off,
      useAlignedDaily ? dOpen3On : dOpen3Off,
      useAlignedDaily ? dOpen4On : dOpen4Off,
      useAlignedDaily ? dOpen5On : dOpen5Off,
      useAlignedDaily ? dOpen6On : dOpen6Off,
      useAlignedDaily ? dOpen7On : dOpen7Off,
      useAlignedDaily ? dOpen8On : dOpen8Off,
      useAlignedDaily ? dOpen9On : dOpen9Off,
      useAlignedDaily ? dOpen10On : dOpen10Off)
    float symLow   = pickFloat(slot,
      useAlignedDaily ? dLow1On : dLow1Off,
      useAlignedDaily ? dLow2On : dLow2Off,
      useAlignedDaily ? dLow3On : dLow3Off,
      useAlignedDaily ? dLow4On : dLow4Off,
      useAlignedDaily ? dLow5On : dLow5Off,
      useAlignedDaily ? dLow6On : dLow6Off,
      useAlignedDaily ? dLow7On : dLow7Off,
      useAlignedDaily ? dLow8On : dLow8Off,
      useAlignedDaily ? dLow9On : dLow9Off,
      useAlignedDaily ? dLow10On : dLow10Off)
    float rawMomentum = pickFloat(slot,
      useAlignedDaily ? dMom1On : dMom1Off,
      useAlignedDaily ? dMom2On : dMom2Off,
      useAlignedDaily ? dMom3On : dMom3Off,
      useAlignedDaily ? dMom4On : dMom4Off,
      useAlignedDaily ? dMom5On : dMom5Off,
      useAlignedDaily ? dMom6On : dMom6Off,
      useAlignedDaily ? dMom7On : dMom7Off,
      useAlignedDaily ? dMom8On : dMom8Off,
      useAlignedDaily ? dMom9On : dMom9Off,
      useAlignedDaily ? dMom10On : dMom10Off)
    float volValue = pickFloat(slot,
      useAlignedDaily ? dVol1On : dVol1Off,
      useAlignedDaily ? dVol2On : dVol2Off,
      useAlignedDaily ? dVol3On : dVol3Off,
      useAlignedDaily ? dVol4On : dVol4Off,
      useAlignedDaily ? dVol5On : dVol5Off,
      useAlignedDaily ? dVol6On : dVol6Off,
      useAlignedDaily ? dVol7On : dVol7Off,
      useAlignedDaily ? dVol8On : dVol8Off,
      useAlignedDaily ? dVol9On : dVol9Off,
      useAlignedDaily ? dVol10On : dVol10Off)
    float signalBaseValue = pickFloat(slot,
      useAlignedDaily ? dSigBase1On : dSigBase1Off,
      useAlignedDaily ? dSigBase2On : dSigBase2Off,
      useAlignedDaily ? dSigBase3On : dSigBase3Off,
      useAlignedDaily ? dSigBase4On : dSigBase4Off,
      useAlignedDaily ? dSigBase5On : dSigBase5Off,
      useAlignedDaily ? dSigBase6On : dSigBase6Off,
      useAlignedDaily ? dSigBase7On : dSigBase7Off,
      useAlignedDaily ? dSigBase8On : dSigBase8Off,
      useAlignedDaily ? dSigBase9On : dSigBase9Off,
      useAlignedDaily ? dSigBase10On : dSigBase10Off)
    float signalValue = pickFloat(slot,
      useAlignedDaily ? dSig1On : dSig1Off,
      useAlignedDaily ? dSig2On : dSig2Off,
      useAlignedDaily ? dSig3On : dSig3Off,
      useAlignedDaily ? dSig4On : dSig4Off,
      useAlignedDaily ? dSig5On : dSig5Off,
      useAlignedDaily ? dSig6On : dSig6Off,
      useAlignedDaily ? dSig7On : dSig7Off,
      useAlignedDaily ? dSig8On : dSig8Off,
      useAlignedDaily ? dSig9On : dSig9Off,
      useAlignedDaily ? dSig10On : dSig10Off)
    float prevSignal = array.get(prevSignalSeries, i)
    array.set(prevSignalSeries, i, signalValue)
    float decisionSignal = useCloseRebalance ? signalValue : prevSignal
    array.set(momentumLookback, i, rawMomentum)
    array.set(volSeries, i, volValue)
    array.set(signalBaseSeries, i, signalBaseValue)
    array.set(signalSeries, i, signalValue)
    array.set(signalDecisionSeries, i, decisionSignal)
    array.set(closeSeries, i, symClose)
    array.set(openSeries, i, symOpen)
    array.set(lowSeries, i, symLow)
    if enableMomentumLog and barstate.isconfirmed and inRange and not na(rawMomentum)
        log.info(str.format("{0} ({1}) {2}日动量: {3,number,#.##}% | Signal: {4,number,#.##}%", sym, array.get(labels, i), lookbackDays, rawMomentum * 100, signalValue * 100))
    if enableAlignmentLog and barstate.isconfirmed and inRange and not na(symTime)
        string chartDateTxt = formatDate(time)
        string symDateTxt = formatDate(symTime)
        if symDateTxt != chartDateTxt
            float dayDiff = (time - symTime) / (24.0 * 60 * 60 * 1000.0)
            log.warning(str.format("时间对齐异常: chart={0} | symDay={1} | Δdays={2,number,#.##} | {3} ({4})", chartDateTxt, symDateTxt, dayDiff, sym, array.get(labels, i)))

int currDayStart = int(time("D"))
bool forceExitExecuted = false
bool forceExitUseClose = forceExitMode == "当日收盘"
bool filterActive = useMarketFilter and marketRiskOff
bool holdingRisky = not na(holdingIdx) and holdingIdx < array.size(riskOffExclude) and array.get(riskOffExclude, holdingIdx)
bool forcedExitChange = false

// 次日开盘强平触发条件（设置待执行）
if forceExitOnFilter and filterActive and holdingRisky and not forceExitUseClose and not forceExitPending
    forceExitPending := true
    forceExitPendingIdx := holdingIdx
    forceExitPendingDay := currDayStart
    forceExitPendingBasis := entryPrice
    forceExitPendingNote := "（次日开盘清仓）"
    if showSwitchLabel
        alert(str.format("强平预告: 风险过滤触发，预计次日开盘清仓 {0}", heldLabel), alert.freq_once_per_bar)

// 次日开盘执行强平
if forceExitPending and currDayStart > forceExitPendingDay
    int exitIdx = forceExitPendingIdx
    if not na(exitIdx)
        string exitSym = array.get(tickers, exitIdx)
        string exitLabel = array.get(labels, exitIdx)
        float exitPrice = roundPrice(array.get(openSeries, exitIdx))
        float basisPrice = forceExitPendingBasis
        float realized = not na(exitPrice) and not na(basisPrice) and basisPrice > 0 ? exitPrice / basisPrice - 1 : na
        if not na(realized)
            equity := equity * (1 + realized)
            equityClosedSeries := equity
            int statsIdx = exitIdx
            float prevMul = array.get(symCumReturn, statsIdx)
            array.set(symCumReturn, statsIdx, nz(prevMul, 1.0) * (1 + realized))
            int prevTrades = array.get(symTradeCount, statsIdx)
            array.set(symTradeCount, statsIdx, prevTrades + 1)
            if realized > 0
                array.set(symWinCount, statsIdx, array.get(symWinCount, statsIdx) + 1)
                array.set(symProfitSum, statsIdx, array.get(symProfitSum, statsIdx) + realized)
            else if realized < 0
                array.set(symLossSum, statsIdx, array.get(symLossSum, statsIdx) + realized)
            sumTradeRet += realized
            sumTradeRetSq += realized * realized
            tradeSamples += 1
        holdingIdx := na
        heldLabel := "未持仓"
        entryPrice := na
        entryEquity := equity
        holdingDays := 0
        lastSellPrice := exitPrice
        holdingChanged := true
        forcedExitChange := true
        rebalancePriceSeries := exitPrice
        forceExitExecuted := true
        if showForceExitLabel and not na(exitPrice)
            string exitTimeTxt = formatDate(time)
            label.new(bar_index, equityClosedSeries, str.format("强平 {0}\n时间: {1} 开盘\n价格: {2}", exitLabel, exitTimeTxt, fmtPrice(exitPrice)), color=color.new(color.red, 0), textcolor=color.white, style=label.style_label_down, size=size.small)
        if showSwitchLabel and not na(exitPrice)
            string exitTimeTxtAlert = formatDate(time)
            alert(str.format("强平[开盘]: {0} @ {1}（{2}）", exitLabel, fmtPrice(exitPrice), exitTimeTxtAlert), alert.freq_once_per_bar)
        if enablePositionLog
            log.error(str.format("风险过滤清仓: {0} @ {1} {2}", exitLabel, fmtPrice(exitPrice), forceExitPendingNote))
        if enableEquityDebug
            log.error(str.format("最新净值: {0,number,#.##}", equityClosedSeries))
    forceExitPending := false
    forceExitPendingIdx := na
    forceExitPendingDay := na
    forceExitPendingBasis := na
    forceExitPendingNote := ""

// 当日收盘强平
if forceExitOnFilter and filterActive and holdingRisky and forceExitUseClose and not forceExitExecuted
    if not na(holdingIdx)
        int exitIdx = holdingIdx
        string exitSym = array.get(tickers, exitIdx)
        string exitLabel = array.get(labels, exitIdx)
        float exitPrice = roundPrice(array.get(closeSeries, exitIdx))
        float basisPrice = entryPrice
        float realized = not na(exitPrice) and not na(basisPrice) and basisPrice > 0 ? exitPrice / basisPrice - 1 : na
        if not na(realized)
            equity := equity * (1 + realized)
            equityClosedSeries := equity
            float prevMul = array.get(symCumReturn, exitIdx)
            array.set(symCumReturn, exitIdx, nz(prevMul, 1.0) * (1 + realized))
            int prevTrades = array.get(symTradeCount, exitIdx)
            array.set(symTradeCount, exitIdx, prevTrades + 1)
            if realized > 0
                array.set(symWinCount, exitIdx, array.get(symWinCount, exitIdx) + 1)
                array.set(symProfitSum, exitIdx, array.get(symProfitSum, exitIdx) + realized)
            else if realized < 0
                array.set(symLossSum, exitIdx, array.get(symLossSum, exitIdx) + realized)
            sumTradeRet += realized
            sumTradeRetSq += realized * realized
            tradeSamples += 1
        holdingIdx := na
        heldLabel := "未持仓"
        entryPrice := na
        entryEquity := equity
        holdingDays := 0
        lastSellPrice := exitPrice
        holdingChanged := true
        forcedExitChange := true
        rebalancePriceSeries := exitPrice
        forceExitExecuted := true
        if showForceExitLabel and not na(exitPrice)
            string exitTimeTxt = formatDate(time)
            label.new(bar_index, equityClosedSeries, str.format("强平 {0}\n时间: {1} 收盘\n价格: {2}", exitLabel, exitTimeTxt, fmtPrice(exitPrice)), color=color.new(color.red, 0), textcolor=color.white, style=label.style_label_down, size=size.small)
        if showSwitchLabel and not na(exitPrice)
            string exitTimeTxtAlert = formatDate(time)
            alert(str.format("强平[收盘]: {0} @ {1}（{2}）", exitLabel, fmtPrice(exitPrice), exitTimeTxtAlert), alert.freq_once_per_bar)
        if enablePositionLog
            log.error(str.format("风险过滤清仓: {0} @ {1}", exitLabel, fmtPrice(exitPrice)))
        if enableEquityDebug
            log.error(str.format("最新净值: {0,number,#.##}", equityClosedSeries))

skipDecisionsDueToPending = forceExitPending and currDayStart == forceExitPendingDay

// === Daily signal evaluation ===
int bestIdx = na
float bestSignal = -10e10
for i = 0 to assetCount - 1
    if not isSymbolEligible(i)
        continue
    float sig = array.get(signalDecisionSeries, i)
    if na(sig)
        continue
    if sig > bestSignal
        bestSignal := sig
        bestIdx := i

bool hadPositionPrev = not na(holdingIdx)
int prevHoldingIdx = holdingIdx
string prevHeldLabel = hadPositionPrev ? array.get(labels, prevHoldingIdx) : "未持仓"
float prevEntryPrice = entryPrice
float prevEntryEquity = entryEquity
float currentSig = hadPositionPrev ? array.get(signalDecisionSeries, holdingIdx) : na
float currentSigVal = na(currentSig) ? -1e10 : currentSig
bool switching = false
bool entering = false
holdingChanged := false
bool decisionMade = false
string decisionMsg = ""
string timingTxt = useCloseRebalance ? "收盘" : "次日开盘"
bool tradeExecuted = false

// === Force-exit pre-alert (intraday, realtime) ===
if enableIntradayPreAlert and barstate.isrealtime and inRange and useMarketFilter and forceExitOnFilter and hadPositionPrev and holdingRisky
    if currDayStart != forcePreAlertDay
        forcePreAlertDay := currDayStart
        forcePreAlertLastMsg := ""
    string forcePreMsg = ""
    if forceExitPending and currDayStart == forceExitPendingDay
        forcePreMsg := str.format("强平预警: 已触发风险过滤，预计次日开盘清仓 {0}（今日不再换仓）", heldLabel)
    else
        if marketWouldRiskOffPre and not marketRiskOff
            string forceTimingTxt = forceExitUseClose ? "当日收盘" : "次日开盘"
            forcePreMsg := str.format("强平盘中预警: 基准可能跌破SMA{0}（若收盘仍成立，将于{1}清仓 {2}）", marketFilterLen, forceTimingTxt, heldLabel)
        else if filterActive
            string forceTimingTxt2 = forceExitUseClose ? "当日收盘" : "次日开盘"
            forcePreMsg := str.format("强平预警: 风险过滤已触发（将于{0}清仓 {1}）", forceTimingTxt2, heldLabel)
    if str.length(forcePreMsg) > 0 and forcePreMsg != forcePreAlertLastMsg
        forcePreAlertLastMsg := forcePreMsg
        alert(forcePreMsg, alert.freq_once_per_bar)
        label.new(bar_index, equityClosedSeries, forcePreMsg, color=color.new(color.red, 0), textcolor=color.white, style=label.style_label_up, size=size.small)

// === Intraday pre-alert (only for close execution) ===
if inRange and enableIntradayPreAlert and useCloseRebalance and barstate.isrealtime and not skipDecisionsDueToPending
    if currDayStart != preAlertDay
        preAlertDay := currDayStart
        preAlertLastMsg := ""
    int bestIdxPre = na
    float bestSigPre = -10e10
    for i = 0 to assetCount - 1
        if not isSymbolEligible(i)
            continue
        int slotPre = array.get(tickerSlots, i)
        float preSig = pickFloat(slotPre,
          dSig1On, dSig2On, dSig3On, dSig4On, dSig5On, dSig6On, dSig7On, dSig8On, dSig9On, dSig10On)
        if na(preSig)
            continue
        if preSig > bestSigPre
            bestSigPre := preSig
            bestIdxPre := i

    float currentSigPre = na
    if hadPositionPrev
        int holdSlot = array.get(tickerSlots, holdingIdx)
        currentSigPre := pickFloat(holdSlot,
          dSig1On, dSig2On, dSig3On, dSig4On, dSig5On, dSig6On, dSig7On, dSig8On, dSig9On, dSig10On)
    float currentSigPreVal = na(currentSigPre) ? -1e10 : currentSigPre

    bool preCanEnter = not hadPositionPrev and not na(bestIdxPre) and bestSigPre >= entryThreshold
    bool preCanSwitch = hadPositionPrev and not na(bestIdxPre) and bestIdxPre != holdingIdx and (bestSigPre - currentSigPreVal) >= switchDelta and bestSigPre > currentSigPreVal
    string preMsg = ""
    if preCanEnter
        preMsg := str.format("盘中预警[收盘]: 可能开仓 {0}（信号={1,number,#.##}% >= 阈值{2,number,#.##}%；可能在收盘前失效）", array.get(labels, bestIdxPre), bestSigPre * 100, entryThreshold * 100)
    else if preCanSwitch
        preMsg := str.format("盘中预警[收盘]: 可能换仓 {0} -> {1}（Δ={2,number,#.##}% >= 阈值{3,number,#.##}%；可能在收盘前失效）", prevHeldLabel, array.get(labels, bestIdxPre), (bestSigPre - currentSigPreVal) * 100, switchDelta * 100)

    if str.length(preMsg) > 0 and preMsg != preAlertLastMsg
        preAlertLastMsg := preMsg
        alert(preMsg, alert.freq_once_per_bar)
        label.new(bar_index, equityClosedSeries, preMsg, color=color.new(color.orange, 0), textcolor=color.white, style=label.style_label_up, size=size.small)

if inRange and barstate.isconfirmed and not skipDecisionsDueToPending
    float bestSig = bestIdx >= 0 ? bestSignal : na
    bool canEnter = na(holdingIdx) and not na(bestIdx) and not na(bestSig) and bestSig >= entryThreshold
    bool canSwitch = hadPositionPrev and not na(bestIdx) and bestIdx != holdingIdx and not na(bestSig) and (bestSig - currentSigVal) >= switchDelta and bestSig > currentSigVal
    if not hadPositionPrev and canEnter
        entering := true
        decisionMade := true
    else if hadPositionPrev and canSwitch
        switching := true
        decisionMade := true
    else
        decisionMade := false

    if decisionMade
        float exitPrice = na
        float realized = na
        bool exitSucceeded = false
        if switching and hadPositionPrev
            exitPrice := roundPrice(useCloseRebalance ? array.get(closeSeries, prevHoldingIdx) : array.get(openSeries, prevHoldingIdx))
            if not na(exitPrice) and not na(entryPrice) and entryPrice > 0
                realized := exitPrice / entryPrice - 1
                equity := equity * (1 + realized)
                equityClosedSeries := equity
                float prevMul = array.get(symCumReturn, prevHoldingIdx)
                array.set(symCumReturn, prevHoldingIdx, nz(prevMul, 1.0) * (1 + realized))
                int prevTrades = array.get(symTradeCount, prevHoldingIdx)
                array.set(symTradeCount, prevHoldingIdx, prevTrades + 1)
                if realized > 0
                    array.set(symWinCount, prevHoldingIdx, array.get(symWinCount, prevHoldingIdx) + 1)
                    array.set(symProfitSum, prevHoldingIdx, array.get(symProfitSum, prevHoldingIdx) + realized)
                else if realized < 0
                    array.set(symLossSum, prevHoldingIdx, array.get(symLossSum, prevHoldingIdx) + realized)
                sumTradeRet += realized
                sumTradeRetSq += realized * realized
                tradeSamples += 1
                exitSucceeded := true
            else
                switching := false
            if exitSucceeded
                lastSellPrice := exitPrice
                holdingDays := 0
                holdingIdx := na
                heldLabel := "未持仓"
                entryPrice := na
                entryEquity := equity
        float buyPrice = na
        bool entrySucceeded = false
        if (entering or switching) and (not switching or exitSucceeded)
            float candidatePrice = roundPrice(useCloseRebalance ? array.get(closeSeries, bestIdx) : array.get(openSeries, bestIdx))
            if not na(candidatePrice)
                holdingIdx := bestIdx
                heldLabel := array.get(labels, bestIdx)
                entryPrice := candidatePrice
                entryEquity := equity
                buyPrice := candidatePrice
                lastBuyPrice := buyPrice
                holdingDays := 0
                entrySucceeded := true
            else
                if switching and exitSucceeded and not na(realized)
                    float revertFactor = 1 + realized
                    if revertFactor != 0
                        // 回滚收益到切换前
                        equity := equity / revertFactor
                        equityClosedSeries := equity
                        holdingIdx := prevHoldingIdx
                        heldLabel := prevHeldLabel
                        entryPrice := prevEntryPrice
                        entryEquity := prevEntryEquity
                        float prevMulRollback = array.get(symCumReturn, prevHoldingIdx)
                        array.set(symCumReturn, prevHoldingIdx, nz(prevMulRollback, 1.0) / revertFactor)
                        int prevTradesRollback = array.get(symTradeCount, prevHoldingIdx)
                        array.set(symTradeCount, prevHoldingIdx, math.max(prevTradesRollback - 1, 0))
                        if realized > 0
                            array.set(symWinCount, prevHoldingIdx, math.max(array.get(symWinCount, prevHoldingIdx) - 1, 0))
                            array.set(symProfitSum, prevHoldingIdx, array.get(symProfitSum, prevHoldingIdx) - realized)
                        else if realized < 0
                            array.set(symLossSum, prevHoldingIdx, array.get(symLossSum, prevHoldingIdx) - realized)
                        sumTradeRet -= realized
                        sumTradeRetSq -= realized * realized
                        tradeSamples := math.max(tradeSamples - 1, 0)
                entering := false
                switching := false
                exitSucceeded := false
                lastSellPrice := na
        if entrySucceeded
            rebalancePriceSeries := entryPrice
        tradeExecuted := entrySucceeded
        if tradeExecuted
            if entering and not switching
                decisionMsg := str.format("开仓[{0}]: {1} @ {2}", timingTxt, heldLabel, fmtPrice(lastBuyPrice))
            else if switching
                decisionMsg := str.format("换仓[{0}]: {1} @ {2} -> {3} @ {4}", timingTxt, prevHeldLabel, fmtPrice(exitPrice), heldLabel, fmtPrice(lastBuyPrice))
            else
                decisionMsg := str.format("平仓[{0}]: {1} @ {2}", timingTxt, prevHeldLabel, fmtPrice(exitPrice))
            if enablePositionLog
                log.error(decisionMsg)
            if enableAlignmentLog
                string chartDateTxt = formatDate(time)
                int bestSlot = not na(bestIdx) ? array.get(tickerSlots, bestIdx) : na
                int bestDayTime = not na(bestSlot) ? pickInt(bestSlot,
                  useAlignedDaily ? dTime1On : dTime1Off,
                  useAlignedDaily ? dTime2On : dTime2Off,
                  useAlignedDaily ? dTime3On : dTime3Off,
                  useAlignedDaily ? dTime4On : dTime4Off,
                  useAlignedDaily ? dTime5On : dTime5Off,
                  useAlignedDaily ? dTime6On : dTime6Off,
                  useAlignedDaily ? dTime7On : dTime7Off,
                  useAlignedDaily ? dTime8On : dTime8Off,
                  useAlignedDaily ? dTime9On : dTime9Off,
                  useAlignedDaily ? dTime10On : dTime10Off) : na
                string bestDateTxt = formatDate(bestDayTime)
                int prevDayTime = na
                if hadPositionPrev and not na(prevHoldingIdx)
                    int prevSlot = array.get(tickerSlots, prevHoldingIdx)
                    prevDayTime := pickInt(prevSlot,
                      useAlignedDaily ? dTime1On : dTime1Off,
                      useAlignedDaily ? dTime2On : dTime2Off,
                      useAlignedDaily ? dTime3On : dTime3Off,
                      useAlignedDaily ? dTime4On : dTime4Off,
                      useAlignedDaily ? dTime5On : dTime5Off,
                      useAlignedDaily ? dTime6On : dTime6Off,
                      useAlignedDaily ? dTime7On : dTime7Off,
                      useAlignedDaily ? dTime8On : dTime8Off,
                      useAlignedDaily ? dTime9On : dTime9Off,
                      useAlignedDaily ? dTime10On : dTime10Off)
                string prevDateTxt = formatDate(prevDayTime)
                log.warning(str.format("成交对齐: chart={0} | bestDay={1} | prevDay={2} | {3}", chartDateTxt, bestDateTxt, prevDateTxt, decisionMsg))
            if showSwitchLabel and str.length(decisionMsg) > 0
                if not na(lastSwitch)
                    label.delete(lastSwitch)
                lastSwitch := label.new(bar_index, equityClosedSeries, decisionMsg, color=color.new(color.blue, 0), textcolor=color.white, style=label.style_label_up)
                alert(decisionMsg, alert.freq_once_per_bar)
        if not tradeExecuted and hadPositionPrev
            holdingDays += 1
    else
        if hadPositionPrev
            holdingDays += 1
else
    if hadPositionPrev and not forceExitExecuted
        holdingDays += 1

holdingChanged := forcedExitChange or tradeExecuted
bool tradeMarkerThisBar = holdingChanged

if enableDecisionLog and inRange and barstate.isconfirmed
    string bestName = not na(bestIdx) ? array.get(labels, bestIdx) : "无可选"
    string currName = hadPositionPrev ? prevHeldLabel : "未持仓"
    float bestPct = not na(bestSignal) ? bestSignal * 100 : na
    float currPct = na(currentSig) ? na : currentSig * 100
    string actionTxt = tradeExecuted ? (hadPositionPrev ? "换仓" : "开仓") : forceExitExecuted ? "强平" : (hadPositionPrev ? "继续持有" : "空仓")
    log.warning(str.format("信号判定: best={0} {1,number,#.##}% | current={2} {3,number,#.##}% | action={4}", bestName, bestPct, currName, currPct, actionTxt))

if not holdingChanged
    rebalancePriceSeries := na

// === 浮动净值与回撤 ===
if not na(holdingIdx)
    float currClose = roundPrice(array.get(closeSeries, holdingIdx))
    if not na(currClose) and not na(entryPrice) and entryPrice > 0
        float dailyReturn = currClose / entryPrice - 1
        equityDailySeries := entryEquity * (1 + dailyReturn)
        holdingPnlSeries := dailyReturn
    else
        equityDailySeries := equityClosedSeries
        holdingPnlSeries := na
else
    equityDailySeries := equityClosedSeries
    holdingPnlSeries := na

float equityLowToday = equityClosedSeries
if not na(holdingIdx)
    float currLow = roundPrice(array.get(lowSeries, holdingIdx))
    if not na(currLow) and not na(entryPrice) and entryPrice > 0
        float lowReturn = currLow / entryPrice - 1
        equityLowToday := entryEquity * (1 + lowReturn)

if not na(peakEquity) and peakEquity > 0
    currentDrawdown := (equityLowToday - peakEquity) / peakEquity
else
    currentDrawdown := 0.0
prevMaxDd = nz(maxDrawdownSeries[1], 0.0)
bool isNewMaxDrawdown = currentDrawdown < prevMaxDd
maxDrawdownSeries := isNewMaxDrawdown ? currentDrawdown : prevMaxDd
if enableDdDebug and barstate.islastconfirmedhistory and not na(currentDrawdown) and currentDrawdown < 0
    log.warning(str.format("当前回撤: {0,number,#.##}% | 最高净值: {1,number,#.##} | 回撤净值: {2,number,#.##}", currentDrawdown * 100, peakEquity, equityLowToday))
if (holdingChanged or forceExitExecuted) and not na(equityClosedSeries)
    bool isNewHigh = equityClosedSeries > peakEquity
    if enableEquityDebug
        float prevLogged = na(lastLoggedEquity) ? equityClosedSeries : lastLoggedEquity
        if na(lastLoggedEquity) or equityClosedSeries != lastLoggedEquity
            log.warning(str.format("净值更新: {0,number,#.###} -> {1,number,#.###}", prevLogged, equityClosedSeries))
        if isNewHigh
            log.error(str.format("净值新高: {0,number,#.###}", equityClosedSeries))
        lastLoggedEquity := equityClosedSeries
    if isNewHigh
        peakEquity := equityClosedSeries
if isNewMaxDrawdown and showMaxDdLabel
    if not na(maxDdLabel)
        label.delete(maxDdLabel)
    maxDdLabel := label.new(bar_index, equityClosedSeries, str.format("最大回撤刷新 {0,number,#.##}%", currentDrawdown * 100), color=color.new(color.maroon, 0), textcolor=color.white, style=label.style_label_down)
else if not showMaxDdLabel and not na(maxDdLabel)
    label.delete(maxDdLabel)
    maxDdLabel := na

holdingColor = not na(holdingIdx) ? getColor(holdingIdx) : color.orange

msPerYear = 365.25 * 24 * 60 * 60 * 1000.0
elapsedYears = (time - backtestStart) / msPerYear
annReturn = elapsedYears > 0 and initialEquity > 0 and equityClosedSeries > 0 ? math.pow(equityClosedSeries / initialEquity, 1.0 / elapsedYears) - 1 : na
meanRet = tradeSamples > 0 ? sumTradeRet / tradeSamples : na
variance = tradeSamples > 0 ? sumTradeRetSq / tradeSamples - (meanRet * meanRet) : na
variance := variance < 0 ? 0 : variance
stdRet = not na(variance) ? math.sqrt(variance) : na
sharpeAnnual = tradeSamples > 1 and stdRet > 0 ? (meanRet / stdRet) * math.sqrt(252) : na

if barstate.islast
    string signalColumnHeader = "最终信号"
    table.cell(infoTable, 0, 0, "品种", text_color=color.white, bgcolor=color.new(color.blue, 40))
    table.cell(infoTable, 1, 0, str.format("{0}日动量", lookbackDays), text_color=color.white, bgcolor=color.new(color.blue, 40))
    table.cell(infoTable, 2, 0, "波动率×权重", text_color=color.white, bgcolor=color.new(color.blue, 40))
    table.cell(infoTable, 3, 0, signalColumnHeader, text_color=color.white, bgcolor=color.new(color.blue, 40))
    table.cell(infoTable, 4, 0, "收盘", text_color=color.white, bgcolor=color.new(color.blue, 40))
    table.cell(infoTable, 5, 0, "开盘", text_color=color.white, bgcolor=color.new(color.blue, 40))
    table.cell(infoTable, 6, 0, "累计盈亏", text_color=color.white, bgcolor=color.new(color.blue, 40))
    table.cell(infoTable, 7, 0, "胜率", text_color=color.white, bgcolor=color.new(color.blue, 40))
    table.cell(infoTable, 8, 0, "盈亏比", text_color=color.white, bgcolor=color.new(color.blue, 40))
    table.cell(infoTable, 9, 0, "过滤", text_color=color.white, bgcolor=color.new(color.blue, 40))
    sortTableRowsBySignal()
    for rank = 0 to assetCount - 1
        row = rank + 1
        symIdx = array.get(displayOrder, rank)
        lbl = array.get(labels, symIdx)
        mom = array.get(momentumLookback, symIdx)
        sig = array.get(signalSeries, symIdx)
        vol = array.get(volSeries, symIdx)
        cls = array.get(closeSeries, symIdx)
        opn = array.get(openSeries, symIdx)
        isHeld = not na(holdingIdx) and holdingIdx == symIdx
        blocked = not isSymbolEligible(symIdx)
        bg = blocked ? color.new(color.gray, 80) : (isHeld ? color.new(color.orange, 50) : color.new(color.black, 0))
        text_color = isHeld ? color.new(color.black, 0) : color.new(color.white, 0)
        cumMul = array.get(symCumReturn, symIdx)
        tradesCnt = array.get(symTradeCount, symIdx)
        winsCnt = array.get(symWinCount, symIdx)
        profSum = array.get(symProfitSum, symIdx)
        lossSum = array.get(symLossSum, symIdx)
        totalPctSym = (nz(cumMul, 1.0) - 1) * 100
        winRateSym = tradesCnt > 0 ? winsCnt * 100.0 / tradesCnt : na
        profitFactor = lossSum < 0 ? profSum / math.abs(lossSum) : na
        table.cell(infoTable, 0, row, lbl, bgcolor=bg, text_color = text_color)
        table.cell(infoTable, 1, row, na(mom) ? "N/A" : str.tostring(mom * 100, format.mintick) + "%", bgcolor=bg, text_color = text_color)
        float volAdjusted = na(vol) ? na : vol * volAdjustWeight
        table.cell(infoTable, 2, row, na(volAdjusted) ? "N/A" : str.tostring(volAdjusted * 100, format.mintick) + "%", bgcolor=bg, text_color = text_color)
        table.cell(infoTable, 3, row, na(sig) ? "N/A" : str.tostring(sig * 100, format.mintick) + "%", bgcolor=bg, text_color = text_color)
        table.cell(infoTable, 4, row, str.tostring(cls, format.mintick), bgcolor=bg, text_color = text_color)
        table.cell(infoTable, 5, row, str.tostring(opn, format.mintick), bgcolor=bg, text_color = text_color)
        table.cell(infoTable, 6, row, str.format("{0,number,#.##}%", totalPctSym), bgcolor=bg, text_color = text_color)
        table.cell(infoTable, 7, row, na(winRateSym) ? "N/A" : str.format("{0,number,#.##}%", winRateSym), bgcolor=bg, text_color = text_color)
        table.cell(infoTable, 8, row, na(profitFactor) ? "N/A" : str.tostring(profitFactor, format.mintick), bgcolor=bg, text_color = text_color)
        table.cell(infoTable, 9, row, blocked ? "停用" : "—", bgcolor=bg, text_color = text_color)
    startText = formatDate(backtestStart)
    endText = formatDate(backtestEnd)
    table.cell(ddTable, 0, 0, "指标", text_color=color.white, bgcolor=color.new(color.blue, 40))
    table.cell(ddTable, 1, 0, "数值", text_color=color.white, bgcolor=color.new(color.blue, 40))
    table.cell(ddTable, 0, 1, "最大回撤", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(ddTable, 1, 1, str.format("{0,number,#.##}%", maxDrawdownSeries * 100), text_color=color.red)
    table.cell(ddTable, 0, 2, "最终净值", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(ddTable, 1, 2, str.format("{0,number,#.##}", nz(equityClosedSeries, 0)), text_color=color.green)
    table.cell(ddTable, 0, 3, "回测范围", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(ddTable, 1, 3, str.format("{0} 至 {1}", startText, endText), text_color=color.black)
    table.cell(ddTable, 0, 4, "年化收益率", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(ddTable, 1, 4, na(annReturn) ? "N/A" : str.format("{0,number,#.##}%", annReturn * 100), text_color=color.black)
    table.cell(ddTable, 0, 5, "夏普比率(年化)", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(ddTable, 1, 5, na(sharpeAnnual) ? "N/A" : str.tostring(sharpeAnnual, format.mintick), text_color=color.black)

showTradeMarker = tradeMarkerThisBar and inRange and barstate.isconfirmed
markerColor = not na(holdingIdx) ? holdingColor : color.new(color.gray, 0)
plotchar(showTradeMarker, title="Trade Marker", char="●", location=location.bottom, color=markerColor, size=size.tiny)

plot(equityClosedSeries, title="Simulated Equity", color=color.teal, linewidth=2)
plot(equityDailySeries, title="Daily Trial Equity", color=color.new(color.gray, 0), linewidth=1, style=plot.style_line, linestyle = plot.linestyle_dotted, display=display.all)
plot(currentDrawdown < 0 ? currentDrawdown * 100 : na, title="Current Drawdown (%)", color=color.new(color.red, 70), linewidth=1, style=plot.style_area, display=display.all, format=format.price, precision=2)
plot(maxDrawdownSeries * 100, title="Max Drawdown To Date (%)", color=color.new(color.red, 40), linewidth=1, style=plot.style_stepline, display=display.all, format=format.price, precision=2)
plot(holdingPnlSeries * 100, title="Holding PnL (%)", color=holdingColor, style=plot.style_columns)
plot(rebalancePriceSeries, title="Rebalance Price", color=holdingColor, display=display.status_line)
